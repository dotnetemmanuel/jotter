---
source: crates/theming/tests/generators.rs
expression: "resolve(\"retro82\", Mode::Dark).with_style(Style::Tui).to_gtk_css()"
---
/* retro82 dark tui */
window {
  background-color: #05182e;
  color: #f6dcac;
  font-family: Inter, sans-serif;
  font-size: 15px;
}

headerbar {
  background-color: #05182e;
  background-image: none;
  color: #f6dcac;
  border-bottom: 1px solid #3f8f8a;
  box-shadow: none;
  padding-left: 0;
}

separator {
  background-color: alpha(#3f8f8a, 0.45);
  min-height: 1px;
  min-width: 1px;
}

paned > separator {
  background-color: alpha(#3f8f8a, 0.45);
  background-image: none;
  min-width: 1px;
  min-height: 1px;
}

.sidebar {
  background-color: #05182e;
}

.sidebar listview {
  background-color: transparent;
  color: #f6dcac;
  padding-top: 2px;
}

.sidebar listview > row {
  border-radius: 0;
  padding: 1px 6px;
  margin: 0;
}

.sidebar listview > row:hover {
  background-color: #134e5a;
}

.sidebar listview > row:selected {
  background-color: #faa968;
  color: #05182e;
}

.sidebar listview > row:selected:hover {
  background-color: #faa968;
  color: #05182e;
}

.vault-name {
  color: #3f8f8a;
  font-size: 14px;
  font-weight: bold;
  padding: 6px 8px 2px 8px;
  border-bottom: 1px solid alpha(#3f8f8a, 0.45);
}

.tree-cursor {
  color: #faa968;
}

.sidebar listview > row:selected .tree-cursor {
  color: #05182e;
}

.tree-inert {
  color: #6d8f8a;
  opacity: 0.55;
}

.tree-title {
  color: #6d8f8a;
  font-size: 14px;
}

.sidebar listview > row:selected .tree-title {
  color: alpha(#05182e, 0.7);
}

.tree-drop {
  box-shadow: inset 0 0 0 1px #faa968;
  border-radius: 0;
}

.sidebar listview:drop(active), .sidebar listview > row:drop(active) {
  box-shadow: none;
  outline: none;
}

button {
  background-color: transparent;
  background-image: none;
  color: #3f8f8a;
  border: none;
  border-radius: 0;
  box-shadow: none;
  padding: 3px 8px;
}

button:hover {
  background-color: #3f8f8a;
  color: #05182e;
}

button:checked {
  background-color: #faa968;
  background-image: none;
  color: #05182e;
}

button.suggested-action {
  background-color: transparent;
  background-image: none;
  color: #faa968;
}

button.suggested-action:hover {
  background-color: #faa968;
  color: #05182e;
}

button.destructive-action {
  background-color: transparent;
  background-image: none;
  color: #f85525;
}

button.destructive-action:hover {
  background-color: #f85525;
  color: #05182e;
}

windowcontrols button, windowcontrols button.titlebutton {
  background-color: transparent;
  background-image: none;
  border: none;
  box-shadow: none;
  color: #f6dcac;
}

windowcontrols button:hover, windowcontrols button.titlebutton:hover {
  background-color: #3f8f8a;
  background-image: none;
  color: #05182e;
  border-radius: 0;
}

windowcontrols button image, windowcontrols button:hover image {
  background: none;
  background-color: transparent;
  background-image: none;
  box-shadow: none;
  color: #f6dcac;
}

entry {
  background-color: #05182e;
  background-image: none;
  color: #f6dcac;
  border: 1px solid alpha(#3f8f8a, 0.55);
  border-radius: 0;
  box-shadow: none;
  outline: none;
  padding: 3px 6px;
}

entry:focus-within, entry:hover, entry:focus-visible {
  outline: none;
  box-shadow: none;
}

entry:focus-within {
  border-color: #3f8f8a;
}

entry > text, entry > text:focus-visible {
  outline: none;
  box-shadow: none;
}

row:focus, row:focus-visible, listview:focus-visible, listbox:focus-visible {
  outline: none;
}

scrollbar {
  background-color: transparent;
  border: none;
}

scrollbar slider {
  background-color: #6d8f8a;
  border: none;
  border-radius: 0;
  min-width: 6px;
  min-height: 6px;
  margin: 0;
}

scrollbar slider:hover {
  background-color: #3f8f8a;
}

popover > contents {
  background-color: #05182e;
  color: #f6dcac;
  border: 1px solid #3f8f8a;
  border-radius: 0;
  box-shadow: none;
}

.picker-scrim {
  background-color: alpha(#05182e, 0.6);
}
