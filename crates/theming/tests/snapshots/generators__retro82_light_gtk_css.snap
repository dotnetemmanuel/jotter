---
source: crates/theming/tests/generators.rs
assertion_line: 34
expression: "resolve(\"retro82\", Mode::Light).to_gtk_css()"
---
/* retro82 light */
window {
  background-color: #f6e8cd;
  color: #0a2138;
  font-family: Inter, sans-serif;
  font-size: 15px;
}

headerbar {
  background-color: #ecdcb8;
  background-image: none;
  color: #0a2138;
  border-bottom: 2px solid #0a2138;
  box-shadow: none;
}

.sidebar {
  background-color: #ecdcb8;
  border-right: 2px solid #0a2138;
}

.sidebar listview {
  background-color: transparent;
  color: #0a2138;
}

.sidebar listview > row {
  border-radius: 3px;
  padding: 3px 8px;
  margin: 1px 6px;
}

.sidebar listview > row:hover {
  background-color: #d8c49a;
}

.sidebar listview > row:selected {
  background-color: #d9762b;
  color: #f6e8cd;
}

.sidebar listview > row:selected:hover {
  background-color: #d9762b;
  color: #f6e8cd;
}

button {
  background-color: #ecdcb8;
  background-image: none;
  color: #0a2138;
  border: 2px solid #0a2138;
  border-radius: 3px;
  box-shadow: none;
  padding: 6px 14px;
}

button:hover {
  background-color: #d8c49a;
}

button.suggested-action {
  background-color: #0a2138;
  background-image: none;
  color: #f6e8cd;
  border-color: #0a2138;
}

button.suggested-action:hover {
  background-color: #d9762b;
  border-color: #d9762b;
  color: #f6e8cd;
}

button.destructive-action {
  background-color: #d83a12;
  background-image: none;
  color: #f6e8cd;
  border-color: #d83a12;
}

button.destructive-action:hover {
  background-color: #d83a12;
}

windowcontrols button, windowcontrols button.titlebutton {
  background-color: transparent;
  background-image: none;
  border: none;
  box-shadow: none;
  color: #0a2138;
}

windowcontrols button:hover, windowcontrols button.titlebutton:hover {
  background-color: #d8c49a;
  background-image: none;
  color: #0a2138;
  border-radius: 3px;
}

windowcontrols button image, windowcontrols button:hover image {
  background: none;
  background-color: transparent;
  background-image: none;
  box-shadow: none;
  color: #0a2138;
}

entry {
  background-color: transparent;
  background-image: none;
  color: #0a2138;
  border: none;
  border-bottom: 2px solid #0a2138;
  border-radius: 0;
  box-shadow: none;
  outline: none;
  padding: 6px 2px;
}

entry:focus-within, entry:hover, entry:focus-visible {
  outline: none;
  box-shadow: none;
}

entry:focus-within {
  border-bottom-color: #d9762b;
}

entry > text, entry > text:focus-visible {
  outline: none;
  box-shadow: none;
}

popover > contents {
  background-color: #ecdcb8;
  color: #0a2138;
  border: 2px solid #0a2138;
  border-radius: 3px;
  box-shadow: none;
}

.picker-scrim {
  background-color: alpha(#f6e8cd, 0.45);
}

.picker {
  background-color: #ecdcb8;
  color: #0a2138;
  border: 2px solid #0a2138;
  border-radius: 3px;
  padding: 8px 10px 6px 10px;
}

.picker entry {
  font-size: 19px;
  padding-bottom: 8px;
}

.picker listview {
  background-color: transparent;
  color: #0a2138;
  margin-top: 6px;
}

.picker listview > row {
  border-radius: 3px;
  padding: 4px 8px;
}

.picker listview > row:hover {
  background-color: #d8c49a;
}

.picker listview > row:selected {
  background-color: #d9762b;
  color: #f6e8cd;
}

.picker-detail {
  color: #5f7d84;
}

.picker listview > row:selected .picker-detail {
  color: alpha(#f6e8cd, 0.65);
}

tooltip {
  background-color: #ecdcb8;
  color: #0a2138;
  border: 2px solid #0a2138;
  border-radius: 3px;
}
