---
source: crates/theming/tests/generators.rs
expression: "resolve(\"retro82\", Mode::Light).to_gtk_css()"
---
/* retro82 light */
window {
  background-color: #f6e8cd;
  color: #24404f;
  font-family: Inter, sans-serif;
  font-size: 15px;
}

headerbar {
  background-color: #f6e8cd;
  background-image: none;
  color: #24404f;
  border-bottom: 1px solid #d8c49a;
  box-shadow: none;
  padding-left: 0;
}

separator {
  background-color: #d8c49a;
  min-height: 1px;
  min-width: 1px;
}

paned > separator {
  background-color: #d8c49a;
  background-image: none;
  min-width: 1px;
  min-height: 1px;
}

.sidebar {
  background-color: #f6e8cd;
}

.sidebar listview {
  background-color: transparent;
  color: #24404f;
  padding-top: 6px;
}

.sidebar listview > row {
  border-radius: 3px;
  padding: 3px 8px;
  margin: 1px 6px;
}

.sidebar listview > row:hover {
  background-color: #d8c49a;
}

.sidebar listview > row:focus-within {
  box-shadow: inset 2px 0 0 0 #d9762b;
}

.vault-name {
  color: #5f7d84;
  font-size: 14px;
  font-weight: bold;
  padding: 8px 10px 4px 10px;
}

.tree-inert {
  color: #5f7d84;
  opacity: 0.55;
}

.tree-title {
  color: #5f7d84;
  font-size: 14px;
}

.sidebar listview > row:selected .tree-title {
  color: alpha(#f6e8cd, 0.7);
}

.tree-drop {
  box-shadow: inset 0 0 0 2px #d9762b;
  border-radius: 3px;
}

.sidebar listview:drop(active), .sidebar listview > row:drop(active) {
  box-shadow: none;
  outline: none;
}

.sidebar listview > row:selected {
  background-color: #d9762b;
  color: #f6e8cd;
}

.sidebar listview > row:selected:hover {
  background-color: #d9762b;
  color: #f6e8cd;
}

button {
  background-color: #ecdcb8;
  background-image: none;
  color: #24404f;
  border: 2px solid #0a2138;
  border-radius: 3px;
  box-shadow: none;
  padding: 6px 14px;
}

button:hover {
  background-color: #d8c49a;
}

button:checked {
  background-color: #d9762b;
  background-image: none;
  color: #f6e8cd;
  border-color: #d9762b;
}

button.suggested-action {
  background-color: #24404f;
  background-image: none;
  color: #f6e8cd;
  border-color: #24404f;
}

button.suggested-action:hover {
  background-color: #d9762b;
  border-color: #d9762b;
  color: #f6e8cd;
}

button.destructive-action {
  background-color: #d83a12;
  background-image: none;
  color: #f6e8cd;
  border-color: #d83a12;
}

button.destructive-action:hover {
  background-color: #d83a12;
}

windowcontrols button, windowcontrols button.titlebutton {
  background-color: transparent;
  background-image: none;
  border: none;
  box-shadow: none;
  color: #24404f;
}

windowcontrols button:hover, windowcontrols button.titlebutton:hover {
  background-color: #d8c49a;
  background-image: none;
  color: #24404f;
  border-radius: 3px;
}

windowcontrols button image, windowcontrols button:hover image {
  background: none;
  background-color: transparent;
  background-image: none;
  box-shadow: none;
  color: #24404f;
}

entry {
  background-color: transparent;
  background-image: none;
  color: #24404f;
  border: none;
  border-bottom: 2px solid #0a2138;
  border-radius: 0;
  box-shadow: none;
  outline: none;
  padding: 6px 2px;
}

entry:focus-within, entry:hover, entry:focus-visible {
  outline: none;
  box-shadow: none;
}

entry:focus-within {
  border-bottom-color: #d9762b;
}

entry > text, entry > text:focus-visible {
  outline: none;
  box-shadow: none;
}

row:focus, row:focus-visible, listview:focus-visible, list:focus-visible {
  outline: none;
}

popover > contents {
  background-color: #ecdcb8;
  color: #24404f;
  border: 2px solid #0a2138;
  border-radius: 3px;
  box-shadow: none;
}

.picker-scrim {
  background-color: alpha(#f6e8cd, 0.45);
}

.rail {
  background-color: #f6e8cd;
  padding: 10px 6px;
}

.rail-button {
  background: none;
  border: none;
  box-shadow: none;
  color: #5f7d84;
  padding: 10px 4px;
  min-height: 0;
  min-width: 0;
  border-radius: 3px;
}

.rail-button label {
  font-family: "CaskaydiaMono Nerd Font", monospace;
  font-size: 21px;
  padding-bottom: 1px;
  border-bottom: 2px solid transparent;
}

.rail-button:hover {
  background-color: #d8c49a;
  color: #24404f;
}

.rail-button:checked {
  background: none;
  color: #d9762b;
}

.rail-button:checked label {
  border-bottom-color: #d9762b;
}

.rail-settings {
  padding-left: 3px;
  padding-right: 6px;
}

.font-tick {
  color: #d9762b;
}

.font-list {
  background-color: transparent;
  color: #24404f;
}

.font-list > row {
  padding: 2px 8px;
  border-radius: 3px;
}

.font-list > row:hover {
  background-color: #d8c49a;
}

.font-list > row:selected {
  background-color: #d8c49a;
  color: #24404f;
  box-shadow: inset 2px 0 0 0 #d9762b;
}

.settings {
  background-color: #f6e8cd;
}

.settings-label {
  color: #5f7d84;
}

.settings-close {
  background: none;
  border: none;
  box-shadow: none;
  color: #24404f;
  padding: 4px 8px;
  min-height: 0;
  min-width: 0;
}

.settings-close:hover {
  background-color: #d8c49a;
  border-radius: 3px;
}

.keysheet-heading {
  color: #d9762b;
  font-size: 14px;
  font-weight: bold;
}

.keysheet-keys {
  color: #5f7d84;
  font-family: "CaskaydiaMono Nerd Font", monospace;
  font-size: 14px;
}

.theme-button {
  padding: 6px;
}

.theme-name {
  font-size: 14px;
}

.conflict {
  background-color: #f6e8cd;
  padding: 10px 12px;
}

.conflict-header {
  padding-bottom: 4px;
  border-bottom: 2px solid #d8c49a;
}

.conflict-heading {
  font-weight: bold;
}

.conflict-progress {
  color: #5f7d84;
  font-size: 14px;
}

.conflict-title {
  font-family: "CaskaydiaMono Nerd Font", monospace;
  font-size: 14px;
  font-weight: bold;
  padding: 2px 6px;
  border-radius: 3px;
}

.conflict-title.conflict-incoming {
  color: #0d6e78;
}

.conflict-title.conflict-yours {
  color: #d9762b;
}

.conflict-title.conflict-resolution {
  color: #24404f;
}

.conflict-body {
  font-family: "CaskaydiaMono Nerd Font", monospace;
  border-radius: 3px;
  padding: 6px 8px;
}

.conflict-body.conflict-incoming, .conflict-body.conflict-incoming text {
  background-color: alpha(#0d6e78, 0.12);
  color: #24404f;
}

.conflict-body.conflict-yours, .conflict-body.conflict-yours text {
  background-color: alpha(#d9762b, 0.12);
  color: #24404f;
}

.conflict-body.conflict-resolution, .conflict-body.conflict-resolution text {
  background-color: #ecdcb8;
  color: #24404f;
}

.conflict-actions {
  padding-top: 4px;
}

.conflict-action {
  padding: 4px 10px;
}

.status-size {
  background: none;
  border: none;
  box-shadow: none;
  color: #5f7d84;
  font-size: 14px;
  padding: 0 8px;
  min-height: 0;
}

.status-size:hover {
  background: none;
  color: #d9762b;
}

.size-step {
  padding: 2px 10px;
  min-width: 0;
}

.size-value {
  font-family: "CaskaydiaMono Nerd Font", monospace;
}

.status-git {
  background: none;
  border: none;
  box-shadow: none;
  color: #5f7d84;
  font-family: "CaskaydiaMono Nerd Font", monospace;
  font-size: 14px;
  padding: 0 8px;
  min-height: 0;
}

.status-git:hover {
  background: none;
  color: #d9762b;
}

.status-broken {
  background: none;
  border: none;
  box-shadow: none;
  color: #d83a12;
  font-size: 14px;
  padding: 0 8px;
  min-height: 0;
}

.status-broken:hover {
  background: none;
  color: #d9762b;
}

.backlinks {
  background-color: #f6e8cd;
}

.backlinks-header {
  background: none;
  border: none;
  box-shadow: none;
  color: #5f7d84;
  font-size: 14px;
  padding: 3px 10px;
  min-height: 0;
}

.backlinks-header:hover {
  background: none;
  color: #24404f;
}

.search-results {
  background-color: transparent;
  color: #24404f;
}

.search-results > row {
  border-radius: 3px;
  padding: 1px 6px;
  margin: 0 6px;
}

.search-results > row:hover {
  background-color: #d8c49a;
}

.search-results > row:selected {
  background-color: #d8c49a;
  color: #24404f;
  box-shadow: inset 2px 0 0 0 #d9762b;
}

.panel-back {
  background: none;
  border: none;
  box-shadow: none;
  color: #24404f;
  padding: 0 4px;
  margin: 0;
  min-height: 0;
  min-width: 0;
}

.panel-back label {
  font-family: "CaskaydiaMono Nerd Font", monospace;
  font-size: 16px;
  margin-bottom: 3px;
}

.panel-back:hover {
  background: none;
  color: #d9762b;
}

.tags-heading {
  color: #5f7d84;
  font-size: 14px;
}

.tag-row {
  padding: 3px 4px;
}

.search-heading {
  margin-top: 14px;
  padding: 2px 2px 4px 2px;
  border-bottom: 1px solid alpha(#0a2138, 0.25);
}

.search-results > row:first-child .search-heading {
  margin-top: 2px;
}

.search-name {
  font-weight: bold;
}

.search-folder {
  color: #5f7d84;
  font-size: 14px;
}

.search-count {
  color: #5f7d84;
  font-size: 14px;
}

.search-snippet {
  color: #5f7d84;
  margin-left: 5px;
  padding: 1px 0 1px 10px;
  border-left: 1px solid alpha(#0a2138, 0.18);
}

.completion list {
  background-color: transparent;
  color: #24404f;
  font-family: Inter, sans-serif;
}

.completion list > row {
  border-radius: 3px;
  padding: 2px 8px;
}

.completion list > row:hover {
  background-color: #d8c49a;
}

.completion list > row:selected {
  background-color: #d9762b;
  color: #f6e8cd;
}

.picker {
  background-color: #ecdcb8;
  color: #24404f;
  border: 2px solid #0a2138;
  border-radius: 3px;
  padding: 8px 10px 6px 10px;
}

.picker entry {
  font-size: 19px;
  padding-bottom: 8px;
}

.picker listview {
  background-color: transparent;
  color: #24404f;
  margin-top: 6px;
}

.picker listview > row {
  border-radius: 3px;
  padding: 4px 8px;
}

.picker listview > row:hover {
  background-color: #d8c49a;
}

.picker listview > row:selected {
  background-color: #d9762b;
  color: #f6e8cd;
}

.picker-detail {
  color: #5f7d84;
}

.picker listview > row:selected .picker-detail {
  color: alpha(#f6e8cd, 0.65);
}

tooltip {
  background-color: #ecdcb8;
  color: #24404f;
  border: 2px solid #0a2138;
  border-radius: 3px;
}
