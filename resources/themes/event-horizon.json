// jotter theme: event-horizon. Two modes in one file.
// Color tokens live per mode under "palette". The structural sections below
// reference those tokens with $name, so one definition resolves to a full
// light or dark theme depending on the selected mode.
{
  "id": "event-horizon",
  "label": "Event Horizon",
  "default_mode": "dark",

  "palette": {
    "dark": {
      "base": "#1c1e26",
      "surface": "#232530",
      "overlay": "#2e303e",
      "text": "#fadad1",
      "muted": "#6c6f93",
      "primary": "#ee64ac",
      "focus": "#26bbd9",
      "info": "#3fc4de",
      "success": "#29d398",
      "warning": "#fab795",
      "danger": "#e95678",
      "accent2": "#59e3e3",
      "codeBg": "#2e303e"
    },
    "light": {
      "base": "#e9dcbd",
      "surface": "#dfd0ac",
      "overlay": "#c8b78e",
      "text": "#2b2833",
      "muted": "#79705f",
      "primary": "#d4267f",
      "focus": "#0c8fa6",
      "info": "#1577a3",
      "success": "#09a96a",
      "warning": "#c2611a",
      "danger": "#db1f4d",
      "accent2": "#0e8a86",
      "codeBg": "#dacda6"
    }
  },

  "chrome": {
    "background": "$base",
    "surface": "$surface",
    "overlay": "$overlay",
    "text": "$text",
    "muted": "$muted",
    "accent": "$primary",
    "focus": "$focus",
    "border": "$text",
    "danger": "$danger",
    "radius": 3,
    "border_width": 2,
    "shadow_offset": 0
  },

  "editor": {
    "background": "$base",
    "foreground": "$text",
    "cursor": "$primary",
    "current_line": "$surface",
    "selection": "$overlay",
    "right_margin": "$overlay",
    "line_number": "$muted",
    "line_number_current": "$text",
    "syntax": {
      "heading": "$primary",
      "emphasis": "$accent2",
      "strong": "$primary",
      "link": "$focus",
      "inline_code": "$accent2",
      "block_quote": "$muted",
      "list_marker": "$info",
      "thematic_break": "$overlay",
      "comment": "$muted"
    }
  },

  "preview": {
    "background": "$base",
    "foreground": "$text",
    "heading": "$text",
    "link": "$focus",
    "muted": "$muted",
    "code_background": "$codeBg",
    "quote_border": "$primary",
    "rule": "$overlay",
    "table_border": "$overlay"
  },

  "code": {
    "background": "$codeBg",
    "foreground": "$text",
    "keyword": "$primary",
    "string": "$success",
    "comment": "$muted",
    "function": "$focus",
    "number": "$warning",
    "type": "$info",
    "variable": "$text"
  },

  "typography": {
    "ui_font": "Inter, sans-serif",
    "editor_font": "\"CaskaydiaMono Nerd Font\", monospace",
    "preview_font": "Inter, sans-serif",
    "mono_font": "monospace",
    "font_size": 15,
    "line_height": 1.6
  }
}
